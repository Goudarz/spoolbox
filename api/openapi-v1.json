        "description": "Text frames `{\"Type\", \"Data\"}`; types: `new` (MessageSummary), `update` (`{ID, Read}` or `{ID, Tags}`), `delete` (`{ID}`), `truncate`, `prune` (reload), `stats` (`{Total, Unread, Version}`)."
      }
    },
    "/livez": {
      "get": {
        "operationId": "livez",
        "summary": "Liveness",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "summary": "Readiness",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Starting or stopping"
          }
        }
      }
    }
