{
  "openapi": "3.1.0",
  "info": {
    "title": "Spoolbox API v1",
    "version": "v1",
    "description": "Stable API used by the web UI and test clients. JSON field names are PascalCase (list summaries use snake_case). Errors are `text/plain` with status 400 (send API: JSON `{\"Error\"}`). Prefix every path with --webroot when set.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Prefix with --webroot when set"
    }
  ],
  "security": [
    {},
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/api/v1/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "List messages, newest first",
        "tags": [
          "messages"
        ],
        "responses": {
          "200": {
            "description": "Page of messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesSummary"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "0 = no limit"
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only messages received before this date/time"
          },
          {
            "name": "tz",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Time zone for dates without offset (IANA name or +03:30)"
          }
        ]
      },
      "put": {
        "operationId": "setReadStatus",
        "summary": "Mark messages read or unread",
        "tags": [
          "messages"
        ],
        "responses": {
          "200": {
            "description": "`ok`",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "By IDs, by search, or (neither) every message.",
        "parameters": [
          {
            "name": "tz",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetRead"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteMessages",
        "summary": "Delete messages",
        "tags": [
          "messages"
        ],
        "responses": {
          "200": {
            "description": "`ok`",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "An empty body or empty `IDs` deletes every message; a body that is not valid JSON is rejected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteMessages"
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "operationId": "search",
        "summary": "Search messages",
        "tags": [
          "messages"
        ],
        "responses": {
          "200": {
            "description": "Page of matching messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesSummary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "start",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "0 = no limit"
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only messages received before this date/time"
          },
          {
            "name": "tz",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Time zone for dates without offset (IANA name or +03:30)"
          }
        ]
      },
      "delete": {
        "operationId": "deleteSearch",
        "summary": "Delete matching messages",
        "tags": [
          "messages"
        ],
        "responses": {
          "200": {
            "description": "`ok`",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "tz",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/message/{id}": {
      "get": {
        "operationId": "getMessage",
